{
  "name": "chatterbox",
  "version": "1.0.0",
  "description": "Chatterbox - Gmail Integration with AI",
  "main": "dist/src/mail/timedPollGmail.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/tokensite && cp -R src/html dist/tokensite",
    "build:clean": "rimraf dist && npm run build",
    "clean": "rimraf dist",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.{ts,js}\" --cache --fix",
    "lint:check": "eslint \"{src,test}/**/*.{ts,js}\" --cache",
    
    "mail:authorize": "ts-node src/mail/authorizeAll.ts",
    "mail:validate": "ts-node src/mail/authorizeGmail.ts",
    "mail:poll": "node dist/src/mail/timedPollGmail.js",
    "mail:poll:single": "node dist/src/mail/pollGmail.js",
    
    "aws:teardown": "bash Cloud/AWS/scripts/complete-teardown.sh",
    "aws:deploy:simple": "bash Cloud/AWS/scripts/deploy-simplified.sh",
    "aws:populate-secrets": "node Cloud/AWS/scripts/populate-secrets.js",
    "aws:logs": "node Cloud/AWS/scripts/aws/get-lambda-logs.js",
    
    "backup:local": "node scripts/backup-local-system.js",
    "clean:local": "node scripts/clean-local-system.js",
    "restore:local": "node scripts/restore-local-system.js",
    
    "test:all": "jest",
    "test:email": "jest test/getMail.test.ts",
    "test:lambda": "jest test/lambdaIntegration.test.ts",
    
    "start": "npm run mail:poll"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@aws-sdk/client-ssm": "^3.0.0",
    "googleapis": "^120.0.0",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^2.8.0",
    "rimraf": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^4.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

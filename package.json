    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^4.2.1",
    "glob": "^10.3.10",
    "jest": "^29.0.0",
    "prettier": "^2.8.0",
    "rimraf": "^3.0.0",
    "ts-jest": "^29.0.0",

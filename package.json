    "@aws-sdk/client-ec2": "^3.843.0",
    "@aws-sdk/client-iam": "^3.840.0",
    "@aws-sdk/client-lambda": "^3.840.0",
    "@aws-sdk/client-resource-groups": "^3.840.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@aws-sdk/client-ses": "^3.840.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@aws-sdk/client-ssm": "^3.0.0",
    "@aws-sdk/client-sts": "^3.840.0",
    "@aws-sdk/lib-dynamodb": "^3.840.0",
    "@aws-sdk/util-dynamodb": "^3.840.0",
    "dotenv": "^17.0.1",
    "googleapis": "^120.0.0",
    "openai": "^4.0.0",

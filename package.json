    "mail:poll:reset:local": "node scripts/reset-local-polling.js",
    "mail:poll:reset": "node scripts/reset-polling.js",
    "mail:poll:test": "node scripts/test-polling.js",
    "mail:site:start": "bin/serve-tokensite.zsh &",

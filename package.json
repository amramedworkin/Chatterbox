{
  "name": "nodetest",
  "version": "1.0.0",
  "description": "A Gmail Poller for LLM Interactions and Testing Utilities",
  "main": "dist/src/mail/timedPollGmail.js",
  "scripts": {
    "build:windows": "tsc && xcopy src\\html dist\\tokensite /D /I /E /Y",
    "build:mac": "tsc && mkdir -p dist/tokensite && cp -R src/html dist/tokensite",
    "build:clean": "rimraf dist && npm run build",
    "build": "npm run build:mac",
    "clean": "bin/clean.ps1",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.{ts,js}\" --cache --fix",
    "lint:nofix": "eslint \"{src,test}/**/*.{ts,js}\" --cache",
    "lint:nofix:nocache": "eslint \"{src,test}/**/*.{ts,js}\"",
    "lint:nocache": "eslint \"{src,test}/**/*.{ts,js}\" --fix",
    "install:create": "node scripts/install/create-installation.js",
    "install:init": "node scripts/install/initialize-system.js",
    "mail:poll": "node dist/src/mail/timedPollGmail.js",
    "mail:poll:single": "node dist/src/mail/pollGmail.js",
    "mail:authorize": "ts-node src/mail/authorizeAll.ts",
    "mail:validate": "ts-node src/mail/authorizeGmail.ts",
    "app:init": "npm run app:init:mail",
    "app:init:mail": "npm run mail:authorize",
    "app:setup:env": "bin/setup-env.sh",
    "serve:start": "bin/serve-tokensite.zsh &",
    "serve:stop": "pkill -f 'http-server.*3000' || pkill -f 'python3.*http.server.*3000'",
    "serve:restart": "npm run serve:stop && sleep 2 && npm run serve:start",
    "backup:local": "node scripts/backup-local-system.js",
    "backup:local:force": "node scripts/backup-local-system.js --force",
    "backup:local:custom": "node scripts/backup-local-system.js --backup-dir ./backups/custom",
    "backup:local:with-name": "node scripts/backup-local-system.js --name",
    "backup:local:with-notes": "node scripts/backup-local-system.js --notes",
    "clean:local": "node scripts/clean-local-system.js",
    "clean:local:force": "node scripts/clean-local-system.js --force",
    "clean:local:wipe": "node scripts/clean-local-system.js --wipe",
    "clean:local:force:wipe": "node scripts/clean-local-system.js --force:quiet --wipe",
    "clean:local:backup": "node scripts/clean-local-system.js --backup-dir ./backups/custom",
    "clean:local:with-name": "node scripts/clean-local-system.js --name",
    "clean:local:with-notes": "node scripts/clean-local-system.js --notes",
    "restore:local": "node scripts/restore-local-system.js",
    "restore:local:force": "node scripts/restore-local-system.js --force",
    "restore:local:custom": "node scripts/restore-local-system.js ./backups/custom",
    "aws:check-prerequisites": "node scripts/aws/check-prerequisites.js",
    "aws:setup-user": "node scripts/aws/setup-user.js",
    "aws:configure": "node scripts/aws/configure-aws.js",
    "aws:setup-backend": "node scripts/aws/setup-backend.js",
    "aws:init": "cd Cloud/AWS/terraform && terraform init -reconfigure",
    "aws:validate": "cd Cloud/AWS/terraform && terraform validate",
    "aws:format": "cd Cloud/AWS/terraform && terraform fmt -recursive",
    "aws:format:check": "cd Cloud/AWS/terraform && terraform fmt -check -recursive",
    "aws:plan": "cd Cloud/AWS/terraform && terraform plan --out=tfplan",
    "aws:plan:show": "cd Cloud/AWS/terraform && terraform show tfplan",
    "aws:plan:summary": "cd Cloud/AWS/terraform && terraform show tfplan | grep -E '(Plan:|to add|to change|to destroy)'",
    "aws:apply": "cd Cloud/AWS/terraform && terraform apply tfplan",
    "aws:apply:auto": "cd Cloud/AWS/terraform && terraform apply -auto-approve",
    "aws:output": "cd Cloud/AWS/terraform && terraform output",
    "aws:output:json": "cd Cloud/AWS/terraform && terraform output -json",
    "aws:state:list": "cd Cloud/AWS/terraform && terraform state list",
    "aws:state:show": "cd Cloud/AWS/terraform && terraform show",
    "aws:destroy": "cd Cloud/AWS/terraform && terraform destroy",
    "aws:destroy:auto": "cd Cloud/AWS/terraform && terraform destroy -auto-approve",
    "aws:force-unlock": "cd Cloud/AWS/terraform && terraform force-unlock",
    "aws:refresh": "cd Cloud/AWS/terraform && terraform refresh",
    "aws:import": "cd Cloud/AWS/terraform && terraform import",
    "aws:taint": "cd Cloud/AWS/terraform && terraform taint",
    "aws:untaint": "cd Cloud/AWS/terraform && terraform untaint",
    "aws:console": "cd Cloud/AWS/terraform && terraform console",
    "aws:graph": "cd Cloud/AWS/terraform && terraform graph",
    "aws:workspace:list": "cd Cloud/AWS/terraform && terraform workspace list",
    "aws:workspace:new": "cd Cloud/AWS/terraform && terraform workspace new",
    "aws:workspace:select": "cd Cloud/AWS/terraform && terraform workspace select",
    "aws:workspace:delete": "cd Cloud/AWS/terraform && terraform workspace delete",
    "aws:setup": "npm run aws:check-prerequisites && npm run aws:setup-backend && npm run aws:init && npm run aws:validate && npm run aws:format",
    "aws:deploy": "npm run aws:validate && npm run aws:format && npm run aws:plan && npm run aws:plan:summary",
    "aws:deploy:auto": "npm run aws:validate && npm run aws:format && npm run aws:plan && npm run aws:apply:auto",
    "aws:validate:infrastructure": "node scripts/aws/validate-infrastructure.js",
    "aws:test:resources": "node scripts/aws/test-resources.js",
    "aws:test:vpc": "node scripts/aws/test-vpc.js",
    "aws:test:dynamodb": "node scripts/aws/test-dynamodb.js",
    "aws:test:s3": "node scripts/aws/test-s3.js",
    "aws:test:secrets": "node scripts/aws/test-secrets.js",
    "aws:test:parameters": "node scripts/aws/test-parameters.js",
    "aws:test:iam": "node scripts/aws/test-iam.js",
    "aws:test:cloudwatch": "node scripts/aws/test-cloudwatch.js",
    "aws:test:all": "npm run aws:test:vpc && npm run aws:test:dynamodb && npm run aws:test:s3 && npm run aws:test:secrets && npm run aws:test:parameters && npm run aws:test:iam && npm run aws:test:cloudwatch",
    "aws:cleanup": "node scripts/aws/cleanup.js",
    "aws:cleanup:user": "node scripts/aws/cleanup-user.js",
    "aws:cleanup:bucket": "node scripts/aws/cleanup-bucket.js",
    "aws:migrate:secrets": "node scripts/aws/migrate-secrets.js",
    "aws:smart-migrate": "node scripts/aws/smart-migrate-secrets.js",
    "aws:update:secret": "node scripts/aws/update-secret.js",
    "aws:rotate:secrets": "node scripts/aws/rotate-secrets.js",
    "aws:secrets:status": "node scripts/aws/rotate-secrets.js --status",
    "aws:env:deploy": "node scripts/aws/manage-environments.js deploy",
    "aws:env:destroy": "node scripts/aws/manage-environments.js destroy",
    "aws:env:list": "node scripts/aws/manage-environments.js list",
    "aws:env:status": "node scripts/aws/manage-environments.js status",
    "aws:env:deploy:dev": "node scripts/aws/manage-environments.js deploy development",
    "aws:env:deploy:staging": "node scripts/aws/manage-environments.js deploy staging",
    "aws:env:deploy:prod": "node scripts/aws/manage-environments.js deploy production",
    "aws:env:destroy:dev": "node scripts/aws/manage-environments.js destroy development",
    "aws:env:destroy:staging": "node scripts/aws/manage-environments.js destroy staging",
    "aws:env:destroy:prod": "node scripts/aws/manage-environments.js destroy production",
    "aws:migrate:secrets:env": "node scripts/aws/migrate-secrets-env.js",
    "aws:migrate:secrets:env:dev": "node scripts/aws/migrate-secrets-env.js development",
    "aws:migrate:secrets:env:staging": "node scripts/aws/migrate-secrets-env.js staging",
    "aws:migrate:secrets:env:prod": "node scripts/aws/migrate-secrets-env.js production",
    "aws:teardown": "node scripts/aws-teardown.js",
    "log:monitor": "node scripts/monitor-admin-log.js",
    "log:monitor:tail": "node scripts/monitor-admin-log.js --tail",
    "log:monitor:all": "node scripts/monitor-admin-log.js --all",
    "log:monitor:lines": "node scripts/monitor-admin-log.js --lines",
    "log:test": "node -e \"const { logInfo, logBuild, logTeardown, logMultiLineTeardown } = require('./dist/utils/adminLogger'); logInfo('Test log entry', 'Testing logging system'); logBuild('Test build', 'Testing build logging'); logTeardown('Test teardown', 'Testing teardown logging'); logMultiLineTeardown('Test multiline', 'Line 1\\nLine 2\\nLine 3'); console.log('Logging test complete');\"",
    "log:test:full": "node scripts/test-logging.js",
    "aws:logs:enable": "export TF_LOG=DEBUG && export TF_LOG_PATH=terraform.log",
    "aws:logs:disable": "unset TF_LOG && unset TF_LOG_PATH",
    "aws:logs:show": "cd Cloud/AWS/terraform && tail -f terraform.log",
    "aws:logs:clear": "cd Cloud/AWS/terraform && rm -f terraform.log",
    "aws:debug:plan": "npm run aws:logs:enable && npm run aws:plan && npm run aws:logs:disable",
    "aws:debug:apply": "npm run aws:logs:enable && npm run aws:apply && npm run aws:logs:disable",
    "aws:cost:estimate": "node scripts/aws/cost-estimate.js",
    "aws:cost:analyze": "node scripts/aws/cost-analyze.js",
    "aws:security:audit": "node scripts/aws/security-audit.js",
    "aws:security:scan": "node scripts/aws/security-scan.js",
    "aws:backup:create": "node scripts/aws/backup-create.js",
    "aws:backup:restore": "node scripts/aws/backup-restore.js",
    "aws:backup:list": "node scripts/aws/backup-list.js",
    "aws:monitor:setup": "node scripts/aws/monitor-setup.js",
    "aws:monitor:dashboard": "node scripts/aws/monitor-dashboard.js",
    "aws:monitor:alarms": "node scripts/aws/monitor-alarms.js",
    "aws:update:variables": "node scripts/aws/update-variables.js",
    "aws:update:backend": "node scripts/aws/update-backend.js",
    "aws:update:modules": "node scripts/aws/update-modules.js",
    "aws:docs:generate": "node scripts/aws/generate-docs.js",
    "aws:docs:validate": "node scripts/aws/validate-docs.js",
    "aws:ci:setup": "npm run aws:check-prerequisites && npm run aws:setup-backend && npm run aws:init",
    "aws:ci:validate": "npm run aws:validate && npm run aws:format:check",
    "aws:ci:plan": "npm run aws:plan",
    "aws:ci:apply": "npm run aws:apply:auto",
    "aws:ci:test": "npm run aws:test:all",
    "aws:ci:cleanup": "npm run aws:destroy:auto",
    "aws:dev:setup": "npm run aws:setup",
    "aws:dev:deploy": "npm run aws:deploy",
    "aws:dev:test": "npm run aws:test:all",
    "aws:dev:cleanup": "npm run aws:cleanup",
    "aws:prod:setup": "npm run aws:setup",
    "aws:prod:deploy": "npm run aws:deploy:auto",
    "aws:prod:validate": "npm run aws:validate:infrastructure",
    "aws:prod:monitor": "npm run aws:monitor:setup",
    "aws:prod:backup": "npm run aws:backup:create",
    "aws:prod:security": "npm run aws:security:audit",
    "aws:prod:cost": "npm run aws:cost:analyze",
    "test:all": "jest",
    "test:completion": "node dist/test/testOpenAiCompletion.js",
    "test:dialog": "ts-node test/dialogAgent.test.ts",
    "test:dialog:basic": "node dist/src/openai/dialogAgent.js \"What is artificial intelligence?\"",
    "test:dialog:custom": "node dist/src/openai/dialogAgent.js \"Write a poem\" --instructions=\"You are a creative poet\"",
    "test:dialog:model": "node dist/src/openai/dialogAgent.js \"Explain quantum computing\" --model=gpt-4o-mini",
    "console:dialog": "ts-node src/openai/dialogConsole.ts",
    "console:dialog:build": "node dist/src/openai/dialogConsole.js",
    "test:emailAgent": "jest test/emailAgent.test.ts",
    "test:agent": "ts-node test/askAgent.test.ts",
    "test:agent:basic": "node dist/src/openai/askAgent.js \"Explain quantum computing\"",
    "test:agent:native": "node dist/src/openai/askAgent.js \"What is machine learning?\" --format=native",
    "test:agent:custom": "node dist/src/openai/askAgent.js \"Write a haiku about coding\" --model=gpt-4o-mini",
    "test:send:basic": "ts-node test/sendGmail.test.ts",
    "test:send:with-id": "ts-node test/sendGmail.test.ts --id 123e4567-e89b-12d3-a456-426614174000",
    "test:send:with-attachments": "ts-node test/sendGmail.test.ts --attach 2",
    "test:send:custom-addresses": "ts-node test/sendGmail.test.ts --sender test@example.com --to destination@example.com --attach 1",
    "test:send:clean": "ts-node test/sendGmail.test.ts --clean",
    "test:send:list-ids": "ts-node test/sendGmail.test.ts --listids",
    "test:send:help": "ts-node test/sendGmail.test.ts --help",
    "test:get": "jest test/getMail.test.ts --noStackTrace -- all",
    "test:get:ids": "jest test/getMail.test.ts --noStackTrace -- ids",
    "test:get:chatterbox": "jest test/getMail.test.ts --noStackTrace -- chatterbox",
    "test:get:conversations": "jest test/getMail.test.ts --noStackTrace -- conversations",
    "test:get:byid": "jest test/getMail.test.ts --noStackTrace -- byid",
    "test:get:byids": "jest test/getMail.test.ts --noStackTrace -- byids",
    "test:get:range": "jest test/getMail.test.ts --noStackTrace -- range",
    "test:get:chatterboxrange": "jest test/getMail.test.ts --noStackTrace -- chatterboxrange",
    "test:get:conversationrange": "jest test/getMail.test.ts --noStackTrace -- conversationrange",
    "test:get:helpers": "jest test/getMail.test.ts --noStackTrace -- helpers",
    "test:get:bysender": "jest test/getMail.test.ts --noStackTrace -- bysender",
    "test:get:chatterboxbysender": "jest test/getMail.test.ts --noStackTrace -- chatterboxbysender",
    "test:get:rangebysender": "jest test/getMail.test.ts --noStackTrace -- rangebysender",
    "test:get:chatterboxrangebysender": "jest test/getMail.test.ts --noStackTrace -- chatterboxrangebysender"
  },
  "keywords": [

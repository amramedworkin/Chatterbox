    "aws:check:ses": "bash Cloud/AWS/scripts/check-ses-status.sh",
    "aws:setup:ses": "bash Cloud/AWS/scripts/setup-ses.sh",
    "aws:cleanup:ses": "bash Cloud/AWS/scripts/cleanup-ses.sh",

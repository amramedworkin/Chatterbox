    "aws:clear:whatif:failed": "node scripts/clear-aws-data.js --status=failed --what-if --quiet",
    "aws:clear:email-queries": "node scripts/clear-aws-data.js --table=email-queries",
    "aws:clear:conversations": "node scripts/clear-aws-data.js --table=conversations",
    "aws:clear:generated-responses": "node scripts/clear-aws-data.js --table=generated-responses",
    "aws:clear:query-records": "node scripts/clear-aws-data.js --table=query-records",
    "aws:clear:user-profiles": "node scripts/clear-aws-data.js --table=user-profiles",
    "aws:clear:whatif:email-queries": "node scripts/clear-aws-data.js --table=email-queries --what-if --quiet",
    "aws:clear:whatif:conversations": "node scripts/clear-aws-data.js --table=conversations --what-if --quiet",
    "aws:clear:whatif:generated-responses": "node scripts/clear-aws-data.js --table=generated-responses --what-if --quiet",
    "aws:clear:whatif:query-records": "node scripts/clear-aws-data.js --table=query-records --what-if --quiet",

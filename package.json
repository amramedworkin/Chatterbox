    "aws:lambda:poll": "node scripts/run-lambda-poll.js",
    "aws:lambda:pull": "node scripts/run-lambda-pull.js",
    "aws:lambda:process": "node scripts/run-lambda-processor.js",
    "aws:lambda:generate": "node scripts/run-lambda-generator.js",
    "aws:response:pull": "node scripts/pull-aws-response.js",
    "aws:query:ids": "node scripts/list-query-ids.js",

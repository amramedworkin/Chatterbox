{
  "name": "chatterbox",
  "version": "1.0.0",
  "description": "Chatterbox - Gmail Integration with AI",
  "main": "dist/src/mail/timedPollGmail.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/tokensite && cp -R src/html dist/tokensite",
    "build:clean": "rimraf dist && npm run build",
    "clean": "rimraf dist",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.{ts,js}\" --cache --fix",
    "lint:check": "eslint \"{src,test}/**/*.{ts,js}\" --cache",
    "mail:authorize": "ts-node src/mail/authorizeAll.ts",
    "mail:validate": "ts-node src/mail/authorizeGmail.ts",
    "mail:poll": "node dist/src/mail/timedPollGmail.js",
    "mail:poll:single": "node dist/src/mail/pollGmail.js",
    "mail:site:start": "bin/serve-tokensite.zsh &",
    "mail:site:stop": "pkill -f 'http-server.*3000' || pkill -f 'python3.*http-server.3000'",
    "aws:deploy:infrastructure": "bash Cloud/AWS/scripts/deploy-infrastructure.sh",
    "aws:deploy:lambda": "bash Cloud/AWS/scripts/deploy-lambda.sh",
    "aws:deploy:secrets": "bash Cloud/AWS/scripts/populate-secrets-from-init.sh",
    "aws:deploy": "bash Cloud/AWS/scripts/deploy-complete.sh",
    "aws:teardown": "bash Cloud/AWS/terraform-simple/teardown.sh",
    "aws:populate-secrets": "node Cloud/AWS/scripts/populate-secrets.js",
    "aws:logs": "node Cloud/AWS/scripts/aws/get-lambda-logs.js",
    "aws:s3:delete-data": "bash Cloud/AWS/scripts/delete-s3-bucket.sh development-chatterbox-data-bucket cliadmin",
    "aws:s3:delete-backup": "bash Cloud/AWS/scripts/delete-s3-bucket.sh development-chatterbox-backup-bucket cliadmin",
    "aws:s3:delete-email-archive": "bash Cloud/AWS/scripts/delete-s3-bucket.sh chatterbox-email-archive cliadmin",
    "aws:s3:delete-all": "npm run aws:s3:delete-data && npm run aws:s3:delete-backup && npm run aws:s3:delete-email-archive",
    "aws:init:prepare": "node scripts/init-migration.js",
    "aws:init:check-prerequisites": "node scripts/check-prerequisites.js",
    "aws:init:migrate": "node Cloud/AWS/scripts/populate-secrets-from-init.js",
    "aws:init:clean": "bash scripts/clean-init-folders.sh",
    "aws:validate": "node scripts/validate-aws-system.js",
    "aws:validate:clean": "node scripts/validate-aws-system.js --clean",
    "aws:cleanup-legacy": "node scripts/cleanup-legacy-parameters.js",
    "backup:local": "node scripts/backup-local-system.js",
    "clean:local": "node scripts/clean-local-system.js",
    "restore:local": "node scripts/restore-local-system.js",
    "validate:local": "node scripts/validate-local-system.js",
    "reset:local": "node scripts/reset-local-system.js",
    "aws:backup": "node scripts/backup-aws-system.js",
    "aws:test": "node scripts/test-aws-system.js",
    "test:all": "jest",
    "test:lambda": "jest test/lambdaIntegration.test.ts",
    "start": "npm run mail:poll",
    "help": "open docs/SYSTEM_SETUP_AND_TEARDOWN.md"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@aws-sdk/client-ssm": "^3.0.0",
    "googleapis": "^120.0.0",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^2.8.0",
    "rimraf": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^4.9.0",
    "glob": "^10.3.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

    "aws:backup": "node scripts/backup-aws-system.js",
    "aws:test:email:roundtrip": "node scripts/run-email-round-trip-tests.js",
    "aws:test:email:ses-to-ses": "node scripts/test-email-ses-to-ses.js",
    "aws:test:email:gmail-to-gmail": "node scripts/test-email-gmail-to-gmail.js",
    "aws:test:email:ses-to-gmail": "node scripts/test-email-ses-to-gmail.js",
    "aws:test:email:gmail-to-ses": "node scripts/test-email-gmail-to-ses.js",
    "aws:test:email:help": "node scripts/test-email-help.js",
    "menu": "node scripts/menu.js",
    "menu:show-scripts": "node scripts/menu.js SCRIPTS",
    "backup:local": "node scripts/backup-local-system.js",
    "clean:local": "node scripts/clean-local-system.js",
    "restore:local": "node scripts/restore-local-system.js",
    "validate:local": "node scripts/validate-local-system.js",
    "reset:local": "node scripts/reset-local-system.js",
    "aws:test": "node scripts/test-aws-system.js",
    "test:all": "jest",
    "test:lambda": "jest test/lambdaIntegration.test.ts",
    "test:mail:send": "ts-node test/sendGmail.test.ts",

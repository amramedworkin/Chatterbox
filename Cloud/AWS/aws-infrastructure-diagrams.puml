@startuml Consolidated Environments
!theme plain
title Chatterbox AWS Infrastructure - Consolidated Environment Management

package "AWS Manager (Consolidated Control)" {
    node "AWS Manager Script\n(aws-manager.js)" as aws_manager {
        node "Build Commands" as build_cmds
        node "Teardown Commands" as teardown_cmds
        node "Check Commands" as check_cmds
        node "Backup/Restore" as backup_cmds
        node "Migration" as migrate_cmds
    }
}

package "Terraform State Management" {
    database "S3 Backend\n(chatterbox-terraform-state)" as terraform_backend
    node "Environment Configs" as env_configs {
        node "development.tfvars" as dev_config
        node "staging.tfvars" as staging_config
        node "production.tfvars" as prod_config
    }
}

package "Development Environment" {
    node "VPC (10.0.0.0/16)" as dev_vpc
    node "Lambda (dev)" as dev_lambda
    node "DynamoDB (dev)" as dev_dynamodb
    node "S3 (dev)" as dev_s3
    node "Secrets (dev)" as dev_secrets
    node "Parameters (dev)" as dev_params
}

package "Staging Environment" {
    node "VPC (10.1.0.0/16)" as staging_vpc
    node "Lambda (staging)" as staging_lambda
    node "DynamoDB (staging)" as staging_dynamodb
    node "S3 (staging)" as staging_s3
    node "Secrets (staging)" as staging_secrets
    node "Parameters (staging)" as staging_params
}

package "Production Environment" {
    node "VPC (10.2.0.0/16)" as prod_vpc
    node "Lambda (prod)" as prod_lambda
    node "DynamoDB (prod)" as prod_dynamodb
    node "S3 (prod)" as prod_s3
    node "Secrets (prod)" as prod_secrets
    node "Parameters (prod)" as prod_params
}

package "Shared Components" {
    node "Terraform Modules" as terraform_modules {
        node "VPC Module" as vpc_module
        node "Lambda Module" as lambda_module
        node "DynamoDB Module" as dynamodb_module
        node "S3 Module" as s3_module
        node "Secrets Module" as secrets_module
        node "Parameters Module" as params_module
        node "CloudWatch Module" as cloudwatch_module
        node "IAM Module" as iam_module
    }
}

package "IAM Management" {
    node "AWS Users" as aws_users {
        node "cliadmin" as cliadmin_user
    }
    node "AWS Groups" as aws_groups {
        node "chatterbox" as chatterbox_group
    }
}

package "Backup & Recovery" {
    database "Backup Storage\n(Cloud/AWS/backups)" as backup_storage
    node "Backup Scripts" as backup_scripts
    node "Restore Scripts" as restore_scripts
}

' Connections - Management Flow
aws_manager --> terraform_backend
aws_manager --> env_configs
env_configs --> dev_config
env_configs --> staging_config
env_configs --> prod_config

' Connections - Environment Deployment
terraform_backend --> dev_vpc
terraform_backend --> staging_vpc
terraform_backend --> prod_vpc

dev_config --> dev_lambda
dev_config --> dev_dynamodb
dev_config --> dev_s3
dev_config --> dev_secrets
dev_config --> dev_params

staging_config --> staging_lambda
staging_config --> staging_dynamodb
staging_config --> staging_s3
staging_config --> staging_secrets
staging_config --> staging_params

prod_config --> prod_lambda
prod_config --> prod_dynamodb
prod_config --> prod_s3
prod_config --> prod_secrets
prod_config --> prod_params

' Connections - Shared Components
terraform_modules --> dev_vpc
terraform_modules --> staging_vpc
terraform_modules --> prod_vpc

terraform_modules --> dev_lambda
terraform_modules --> staging_lambda
terraform_modules --> prod_lambda

terraform_modules --> dev_dynamodb
terraform_modules --> staging_dynamodb
terraform_modules --> prod_dynamodb

terraform_modules --> dev_s3
terraform_modules --> staging_s3
terraform_modules --> prod_s3

terraform_modules --> dev_secrets
terraform_modules --> staging_secrets
terraform_modules --> prod_secrets

terraform_modules --> dev_params
terraform_modules --> staging_params
terraform_modules --> prod_params

' Connections - IAM
aws_manager --> aws_users
aws_manager --> aws_groups
cliadmin_user --> chatterbox_group

' Connections - Backup
aws_manager --> backup_storage
backup_storage --> backup_scripts
backup_storage --> restore_scripts

' Migration Paths
dev_secrets -.-> staging_secrets : Migration
staging_secrets -.-> prod_secrets : Migration
dev_params -.-> staging_params : Migration
staging_params -.-> prod_params : Migration

@enduml 
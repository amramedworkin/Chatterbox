@startuml Development Environment
!theme plain
title Chatterbox AWS Infrastructure - Development Environment

package "Development Environment" {
    package "VPC (10.0.0.0/16)" {
        package "Public Subnets" {
            node "Public Subnet A\n(10.0.1.0/24)" as pub_subnet_a
            node "Public Subnet B\n(10.0.2.0/24)" as pub_subnet_b
        }
        
        package "Private Subnets" {
            node "Private Subnet A\n(10.0.10.0/24)" as priv_subnet_a
            node "Private Subnet B\n(10.0.11.0/24)" as priv_subnet_b
        }
        
        node "Internet Gateway" as igw
        node "NAT Gateway A" as nat_a
        node "NAT Gateway B" as nat_b
        
        node "VPC Endpoints" as vpc_endpoints {
            node "S3 Endpoint" as s3_endpoint
            node "DynamoDB Endpoint" as dynamodb_endpoint
            node "Secrets Manager Endpoint" as secrets_endpoint
            node "SSM Endpoint" as ssm_endpoint
        }
    }
    
    package "Compute & API" {
        node "Lambda Function\n(development-chatterbox-email-reader)" as lambda_dev
        node "API Gateway\n(HTTP API)" as api_gateway_dev
    }
    
    package "Data Storage" {
        database "DynamoDB\n(chatterbox-dev-state)" as dynamodb_dev
        database "S3 Data Bucket\n(chatterbox-dev-data)" as s3_data_dev
        database "S3 Backup Bucket\n(chatterbox-dev-backups)" as s3_backup_dev
    }
    
    package "Security & Configuration" {
        database "Secrets Manager" as secrets_dev {
            node "Gmail Tokens\n(chatterbox-dev/gmail-tokens)" as gmail_secret_dev
            node "Google Credentials\n(chatterbox-dev/google-credentials)" as google_secret_dev
            node "OpenAI API Key\n(chatterbox-dev/openai-api-key)" as openai_secret_dev
        }
        
        database "Parameter Store" as params_dev {
            node "App Config\n(/chatterbox-dev/app-config)" as app_param_dev
            node "Google Config\n(/chatterbox-dev/google-config)" as google_param_dev
            node "OpenAI Config\n(/chatterbox-dev/openai-config)" as openai_param_dev
            node "Polling Config\n(/chatterbox-dev/polling-config)" as polling_param_dev
        }
    }
    
    package "Monitoring" {
        node "CloudWatch" as cloudwatch_dev {
            node "Log Groups" as logs_dev
            node "Dashboards" as dashboard_dev
            node "Alarms" as alarms_dev
        }
    }
    
    package "IAM" {
        node "IAM Roles" as iam_dev {
            node "Lambda Execution Role\n(development-chatterbox-lambda-role)" as lambda_role_dev
            node "Main Application Role\n(development-chatterbox-role)" as app_role_dev
        }
    }
}

' Connections
internet --> igw
igw --> pub_subnet_a
igw --> pub_subnet_b
pub_subnet_a --> nat_a
pub_subnet_b --> nat_b
nat_a --> priv_subnet_a
nat_b --> priv_subnet_b

lambda_dev --> priv_subnet_a
api_gateway_dev --> lambda_dev

lambda_dev --> dynamodb_dev
lambda_dev --> s3_data_dev
lambda_dev --> s3_backup_dev
lambda_dev --> secrets_dev
lambda_dev --> params_dev

lambda_dev --> cloudwatch_dev
lambda_dev --> iam_dev

@enduml


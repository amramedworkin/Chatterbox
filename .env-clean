# .env file for sensitive and environment-specific configuration overrides
# This file should NOT be committed to version control (e.g., Git).

# --- Sensitive Data ---
# Your OpenAI API Key. Required by converseWithLlm.js
# OPENAI_LLM_MODEL=gpt-4-turbo # Default model, can be overridden in config.json
# OPENAI_MAX_RESPONSE_TOKENS=2000 # Default token limit, can be overridden in config.json
# OPENAI_ORGANIZATION_ID= # Optional, if you have an OpenAI organization ID
OPENAI_API_KEY=<YOUR-OPENAI-API-KEY>

# --- Optional Overrides (Uncomment and set to override defaults from config.json) ---
# Values set here will take precedence over the corresponding defaults in src/config.json.
# Paths specified here should be relative to the PROJECT ROOT, as .env is in the root.

# App-level configurations
# INTERACTIONS_BASE_FOLDER=./custom_interactions_folder # Example override: Path from project root
# DEFAULT_POLL_GMAIL_USER=my.custom.email@gmail.com
# TEST_ATTACHMENTS_FOLDER=./test/custom_attachments_folder # Path from project root

# Google-related file paths and OAuth settings
# CREDENTIALS_PATH=./custom_credentials.json # Path from project root (e.g., if you moved it)
# POLL_TOKEN_PATH=./data/custom_token.json # Path from project root
# LAST_HISTORY_ID_PATH=./data/custom_last_history_id.txt # Path from project root
# LAST_POLLED_EMAIL_PATH=./data/custom_last_polled_email.txt # Path from project root
# TOTAL_POLL_CYCLES_PATH=./data/custom_total_poll_cycles.txt # Path from project root
# GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.compose
# REDIRECT_URI=http://localhost:4000

# Polling behavior
# DEFAULT_POLL_INTERVAL_MINUTES=0.5
# DEFAULT_POLL_DURATION_MINUTES=120

# Feature flags
# DEFAULT_SILENT_FLAG=true

# OpenAI model and token limits
# OPENAI_LLM_MODEL=gpt-4-turbo
# OPENAI_MAX_RESPONSE_TOKENS=2000

# SendTest specific configurations
# SENDTEST_TOKEN_PATH=./data/custom_sendtest_token.json # Path from project root
# SENDTEST_LAST_SENT_EMAIL_NUMBER_PATH=./data/custom_sendtest_last_sent_email_number.txt # Path from project root
# SENDTEST_SENDER_EMAIL_PATH=./data/custom_sendtest_sender_email.txt # Path from project root
# SENDTEST_RECIPIENT_EMAIL_PATH=./data/custom_sendtest_recipient_email.txt # Path from project root
# SENDTEST_SEND_COUNT_PATH=./data/custom_sendtest_send_count.txt # Path from project root
# DEFAULT_SENDTEST_SENDER=custom.sender@example.com
# DEFAULT_SENDTEST_RECIPIENT=custom.recipient@example.com
# SENDTEST_SCOPES=https://www.googleapis.com/auth/gmail.send

# TestOpenAI specific configurations
# TESTOPENAI_PROMPT="Explain the concept of quantum entanglement in simple terms."
# TESTOPENAI_DIALOG_PROMPTS=""Hello, LLM. How are you today|Can you tell me a short, funny story about a talking cat?|What did the cat say or do next? Make it even funnier?|Summarize our conversation so far in one sentence."

# Environment Variables for Chatterbox Configuration
# This file should NOT be committed to version control (e.g., Git).
# Copy this file to .env and uncomment/set values to override config.json defaults

# =============================================================================
# APP CONFIGURATION
# =============================================================================

# Base folder for interactions (relative to project root)
# INTERACTIONS_BASE_FOLDER=../interactions

# Default Gmail user for polling emails
# DEFAULT_POLL_GMAIL_USER=YOUR-POLL-GMAIL-USER-HERE

# Default Gmail user for sending emails
# DEFAULT_SEND_GMAIL_USER=YOUR-SEND-GMAIL-USER-HERE

# Default Gmail user for getting emails
# DEFAULT_GET_GMAIL_USER=YOUR-GET-GMAIL-USER-HERE

# =============================================================================
# GOOGLE API CONFIGURATION
# =============================================================================

# Path to Google credentials JSON file
# GOOGLE_CREDENTIALS_PATH=./credentials.json

# Path to poll token JSON file
# GOOGLE_POLL_TOKEN_PATH=./data/token.json

# Path to last history ID file
# GOOGLE_LAST_HISTORY_ID_PATH=./data/last_history_id.txt

# Path to last polled email file
# GOOGLE_LAST_POLLED_EMAIL_PATH=./data/last_polled_email.txt

# Path to total poll cycles file
# GOOGLE_TOTAL_POLL_CYCLES_PATH=./data/total_poll_cycles.txt

# Google OAuth2 scopes (space-separated)
# GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send

# OAuth2 redirect URI
# GOOGLE_REDIRECT_URI=http://localhost:3000

# =============================================================================
# POLLING CONFIGURATION
# =============================================================================

# Default polling interval in minutes
# DEFAULT_POLL_INTERVAL_MINUTES=2.0

# Default polling duration in minutes
# DEFAULT_POLL_DURATION_MINUTES=60

# =============================================================================
# FLAGS CONFIGURATION
# =============================================================================

# Default silent flag
# DEFAULT_SILENT_FLAG=false

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================

# OpenAI API Key (REQUIRED for LLM interactions)
OPENAI_API_KEY=YOUR-OPENAI-API-KEY-HERE

# OpenAI LLM model to use
# OPENAI_LLM_MODEL=gpt-4o

# OpenAI organization ID
# OPENAI_ORGANIZATION_ID=YOUR-OPENAI-ORGANIZATION-ID-HERE

# Maximum response tokens
# OPENAI_MAX_RESPONSE_TOKENS=10000

# =============================================================================
# SEND TEST CONFIGURATION
# =============================================================================

# Test attachments folder path
# SENDTEST_ATTACHMENTS_FOLDER=./test/attachments

# Send test token path
# SENDTEST_TOKEN_PATH=./data/sendtest_token.json

# Last sent email number path
# SENDTEST_LAST_SENT_EMAIL_NUMBER_PATH=./data/sendtest_last_sent_email_number.txt

# Sender email path
# SENDTEST_SENDER_EMAIL_PATH=./data/sendtest_sender_email.txt

# Recipient email path
# SENDTEST_RECIPIENT_EMAIL_PATH=./data/sendtest_recipient_email.txt

# Send count path
# SENDTEST_SEND_COUNT_PATH=./data/sendtest_send_count.txt

# Default recipient for send tests
# DEFAULT_SENDTEST_RECIPIENT=YOUR-SENDTEST-RECIPIENT-HERE

# Send test OAuth2 scopes (space-separated)
# SENDTEST_SCOPES=https://www.googleapis.com/auth/gmail.send

# =============================================================================
# TEST OPENAI CONFIGURATION
# =============================================================================

# Test prompt for OpenAI
# TESTOPENAI_PROMPT=Explain the concept of quantum entanglement in simple terms.

# Dialog prompts for OpenAI testing (pipe-separated)
# TESTOPENAI_DIALOG_PROMPTS=Hello, LLM. How are you today?|Can you tell me a short, funny story about a talking cat?|What did the cat say or do next? Make it even funnier.|Summarize our conversation so far in one sentence.

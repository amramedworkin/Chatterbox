{
  "root": true,
  "env": {
    "node": true,
    "es2021": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "./tsconfig.json",
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:prettier/recommended"
  ],
  "rules": {
    "no-console": "off",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-var-requires": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**/*.js"],
      "rules": {
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": "off",
        "no-case-declarations": "off",
        "no-prototype-builtins": "off",
        "no-undef": "off",
        "no-inner-declarations": "off",
        "no-useless-escape": "off"
      }
    },
    {
      "files": ["**/*.test.{js,ts}", "**/*.spec.{js,ts}", "**/test/**/*.{js,ts}"],
      "env": {
        "jest": true
      },
      "extends": [
        "plugin:@typescript-eslint/recommended",
        "plugin:jest/recommended"
      ],
      "rules": {
        "jest/valid-expect": "error",
        "@typescript-eslint/no-var-requires": "off"
      }
    },
    {
      "files": ["**/*.js"],
      "parser": "espree",
      "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "module"
      },
      "extends": ["eslint:recommended"],
      "rules": {
        "no-unused-vars": "warn"
      }
    },
    {
      "files": [
        "src/lambda/pullLatestChatterboxEmail.ts",
        "src/mail/getGmail.ts",
        "src/mail/getLatestGmail.ts",
        "src/mail/pollGmail.ts",
        "src/openai/askAgent.ts",
        "src/openai/dialogAgent.ts",
        "src/openai/dialogConsole.ts",
        "src/utils/awsSecrets.ts"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    },
    {
      "files": ["**/*.test.{js,ts}", "**/*.spec.{js,ts}", "**/test/**/*.{js,ts}"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "jest/no-conditional-expect": "off"
      }
    },
    {
      "files": [
        "src/aws/emailProcessor.ts",
        "src/aws/responseGenerator.ts",
        "src/mail/processIncomingMail.ts",
        "src/mail/generateResponses.ts",
        "src/mail/sendGmail.ts",
        "src/mail/authorizeGmail.ts",
        "src/mail/pollGmail.ts"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-non-null-assertion": "off",
        "@typescript-eslint/no-unused-vars": "off"
      }
    }
  ]
}
